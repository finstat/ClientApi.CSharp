<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Birko.Xaml.Avalonia.Controls;assembly=Birko.Xaml.Avalonia"
        x:Class="DesktopFinstatApiTester.Views.CompareWindow"
        Title="Compare" Width="1100" Height="780"
        WindowStartupLocation="CenterOwner"
        Icon="/favicon.ico"
        FontFamily="{DynamicResource BFont}"
        Background="{DynamicResource BBgSecondaryBrush}"
        Foreground="{DynamicResource BTextBrush}">

  <Window.Styles>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource BTextSecondaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="{DynamicResource BFontMono}" />
      <Setter Property="FontSize" Value="{DynamicResource BTextSm}" />
    </Style>
  </Window.Styles>

  <!-- Sends the request recorded in a history row to a baseline profile and to any number of other profiles, for one
       IČO or a list of them, and compares each body with the baseline's. Mirrors the web tester's compare page. -->
  <DockPanel Margin="{DynamicResource MarginSm}">

    <TextBlock DockPanel.Dock="Top" x:Name="textBlockTitle" Margin="0,0,0,8"
               FontFamily="{DynamicResource BFontHeading}" FontSize="{DynamicResource BTextLg}" FontWeight="SemiBold"
               ToolTip.Tip="Every profile is called in the format picked below and compared with the baseline. An XML body is compared as a tree: repeated elements become a list, xsi:nil becomes null. Each call counts against the quota of the profile it goes to." />

    <!-- Folds away once a comparison runs, so the results get the room. -->
    <Expander DockPanel.Dock="Top" x:Name="expanderSetup" Header="Setup" IsExpanded="True"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="8">
        <TextBlock Classes="caption" Text="Baseline" />
        <StackPanel x:Name="panelBase" Orientation="Horizontal" Spacing="6" />
        <TextBlock Classes="caption" Text="Compare with" />
        <StackPanel x:Name="panelRows" Spacing="6" />
        <Button x:Name="buttonAdd" Content="Add profile" HorizontalAlignment="Left" Click="buttonAdd_Click" />

        <StackPanel x:Name="panelValues" Spacing="4" MaxWidth="640" HorizontalAlignment="Left">
          <TextBlock Classes="caption" Text="IČOs" />
          <!-- A comma, semicolon, space, new line or tab ends an IČO, so a pasted list splits on its own. -->
          <c:TagInput x:Name="tagInputValues" Width="640" Separators=",; &#10;&#9;"
                      Placeholder="Type or paste IČOs; a comma, space or new line ends each one"
                      TagsChanged="tagInputValues_TagsChanged" />
          <TextBlock Text="A list of IČOs is compared one by one; the history keeps the comparison, not its calls."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource BTextMutedBrush}" FontSize="{DynamicResource BTextSm}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="16">
          <StackPanel Spacing="4">
            <TextBlock Classes="caption" Text="Response type" />
            <ComboBox x:Name="comboBoxFormat" Width="110" />
          </StackPanel>
          <StackPanel x:Name="panelConcurrency" Spacing="4">
            <TextBlock Classes="caption" Text="IČOs at once" />
            <ComboBox x:Name="comboBoxConcurrency" Width="80" />
          </StackPanel>
        </StackPanel>

        <CheckBox x:Name="checkBoxHideHosts" IsChecked="True"
                  Content="Ignore host names: each profile's SK and CZ hosts count as {sk} and {cz}"
                  IsCheckedChanged="checkBoxHideHosts_Changed" />
        <Button x:Name="buttonRun" HorizontalAlignment="Left" Click="buttonRun_Click" />
      </StackPanel>
    </Expander>

    <StackPanel DockPanel.Dock="Top" x:Name="panelProgress" Orientation="Horizontal" Spacing="8"
                Margin="0,8" IsVisible="False">
      <ProgressBar x:Name="progressBar" Width="320" VerticalAlignment="Center" />
      <TextBlock x:Name="textBlockProgress" VerticalAlignment="Center" />
      <Button x:Name="buttonStop" Content="Stop" Click="buttonStop_Click" />
    </StackPanel>

    <Grid RowDefinitions="Auto,*">
      <!-- One row per IČO, one column per profile; a compared cell shows its result and opens its diff. -->
      <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,8">
        <Grid x:Name="gridResults" />
      </ScrollViewer>

      <TabControl Grid.Row="1" x:Name="tabControlDetail" IsVisible="False">
        <TabItem Header="Diff">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,4,0,8">
              <TextBlock x:Name="textBlockDiffTitle" VerticalAlignment="Center" FontWeight="SemiBold" />
              <Button x:Name="buttonBodyA" Content="Baseline body" Click="buttonBodyA_Click" />
              <Button x:Name="buttonBodyB" Content="Compared body" Click="buttonBodyB_Click" />
            </StackPanel>
            <!-- Birko's diff viewer (b-json-diff's tree view): changed branches start open; its toolbar can hide
                 the equal ones. -->
            <c:JsonDiffViewer x:Name="diffViewer" />
          </DockPanel>
        </TabItem>
        <TabItem x:Name="tabItemFields" Header="Fields that differ">
          <TextBox x:Name="textBoxFields" Classes="mono" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
