<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Birko.Xaml.Avalonia.Controls;assembly=Birko.Xaml.Avalonia"
        x:Class="DesktopFinstatApiTester.Views.MainWindow"
        Title="FinStat API Tester"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="/favicon.ico"
        FontFamily="{DynamicResource BFont}"
        Background="{DynamicResource BBgSecondaryBrush}"
        Foreground="{DynamicResource BTextBrush}">

  <Window.Styles>
    <!-- Link look for the About modal: Birko's Button theme is a filled primary button, and its
         hover/pressed setters target the Button's own Background, so a class style can override them. -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource BColorPrimaryBrush}" />
      <Setter Property="Padding" Value="0,2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.link:pointerover, Button.link:pressed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource BColorPrimaryHoverBrush}" />
    </Style>
    <Style Selector="TextBlock.aboutHeading">
      <Setter Property="Foreground" Value="{DynamicResource BTextSecondaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
  </Window.Styles>

  <!-- Root panel: the workspace plus the overlay layers (dialogs, settings modal, command
       palette). DialogService hosts its overlays in this panel. -->
  <Panel x:Name="rootPanel">

    <DockPanel>

      <!-- ── Ribbon, with the title bar folded into its tab row (Office-style): brand before the tabs,
           theme / palette / settings / about after them. A separate header row above the ribbon cost a
           full BHeaderHeight of vertical space for a strip that was mostly empty. Tabs are built in
           MainWindow_Ribbon.cs. ── -->
      <c:Ribbon DockPanel.Dock="Top" x:Name="ribbon">
        <c:Ribbon.LeadingContent>
          <TextBlock Text="FinStat API Tester" VerticalAlignment="Center" Margin="4,0,16,0"
                     FontFamily="{DynamicResource BFontHeading}"
                     FontSize="{DynamicResource BTextLg}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource BTextBrush}" />
        </c:Ribbon.LeadingContent>
        <c:Ribbon.TrailingContent>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0">
            <!-- The active environment profile, switched and saved here as "Use and Save" would; its dot
                 is the profile's colour (production red). The port is set in Settings. -->
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Ellipse x:Name="ellipseProfileColor" Width="10" Height="10" VerticalAlignment="Center" />
              <ComboBox x:Name="comboBoxProfile" MinWidth="130" VerticalAlignment="Center"
                        AutomationProperties.Name="Profile"
                        SelectionChanged="comboBoxProfile_SelectionChanged" />
            </StackPanel>
            <ComboBox x:Name="comboBoxTheme" MinWidth="120" VerticalAlignment="Center"
                      ToolTip.Tip="Switch the Birko theme"
                      SelectionChanged="comboBoxTheme_SelectionChanged" />
            <!-- Short label: in the tab row every pixel here is taken from the tabs at narrow widths.
                 The name lives in the tooltip and the accessible name. -->
            <Button x:Name="buttonCommands" Content="🔍  Ctrl+K" Padding="12,4"
                    ToolTip.Tip="Commands (Ctrl+K)" AutomationProperties.Name="Commands"
                    VerticalAlignment="Center" Click="buttonCommands_Click" />
            <!-- Settings is the Quick Access Toolbar's default (⚙) and the Environment tab's launcher. -->
            <Button x:Name="buttonAbout" Content="About" Padding="12,4"
                    VerticalAlignment="Center" Click="buttonAbout_Click" />
          </StackPanel>
        </c:Ribbon.TrailingContent>
      </c:Ribbon>

      <!-- ── Status bar: the active profile and its hosts on the left, API limits on the right; its top
           edge takes the profile's colour (MainWindow_Profiles.cs). ─── -->
      <Border x:Name="borderStatusBar" DockPanel.Dock="Bottom" Height="{DynamicResource BStatusBarHeight}"
              Background="{DynamicResource BBgBrush}"
              BorderBrush="{DynamicResource BBorderBrush}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto" Margin="12,0">
          <TextBlock x:Name="textBlockStatusBarLeft" VerticalAlignment="Center"
                     Foreground="{DynamicResource BTextMutedBrush}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                      DataContext="{Binding Limits}">
            <TextBlock Text="Limits: " Foreground="{DynamicResource BTextMutedBrush}" />
            <TextBlock Text="Daily " Foreground="{DynamicResource BTextMutedBrush}" />
            <TextBlock Text="{Binding Daily.Current}" Foreground="{DynamicResource BTextBrush}" />
            <TextBlock Text="/" Foreground="{DynamicResource BTextMutedBrush}" />
            <TextBlock Text="{Binding Daily.Max}" Foreground="{DynamicResource BTextBrush}" />
            <TextBlock Text="  |  Monthly " Foreground="{DynamicResource BTextMutedBrush}" />
            <TextBlock Text="{Binding Monthly.Current}" Foreground="{DynamicResource BTextBrush}" />
            <TextBlock Text="/" Foreground="{DynamicResource BTextMutedBrush}" />
            <TextBlock Text="{Binding Monthly.Max}" Foreground="{DynamicResource BTextBrush}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ── Workspace: request history (left) + response inspector (right) ──── -->
      <Grid ColumnDefinitions="45*,55*">

        <DataGrid x:Name="datagridResponse" Grid.Column="0"
                  Margin="{DynamicResource MarginSm}"
                  ItemsSource="{Binding ResponseItems}"
                  SelectionMode="Single" IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  SelectionChanged="datagridResponse_SelectionChanged">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="CURL Command" Click="dataGridCurlCommand_Click" />
              <MenuItem Header="Repeat Request" Click="dataGridRepeatRequest_Click" />
              <MenuItem Header="Compare Across Profiles" Click="dataGridCompare_Click" />
              <Separator />
              <MenuItem Header="Show Error Response" Click="dataGridShowResponseOutputWindow_Click" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <!-- Seven columns in a ~575dip pane: the fixed-shape columns size to their content and
                 only the two free-text ones stretch. MinWidth keeps every header legible instead of
                 clipping it away, falling back to a horizontal scrollbar on a narrow window. -->
            <DataGridTextColumn Header="Source" Width="Auto" MinWidth="70" Binding="{Binding ApiSource}" />
            <DataGridTextColumn Header="Profile" Width="Auto" MinWidth="80" Binding="{Binding Profile}" />
            <DataGridTextColumn Header="Request" Width="2*" MinWidth="95" Binding="{Binding DisplayRequest}" />
            <DataGridTextColumn Header="Parameters" Width="3*" MinWidth="115" Binding="{Binding Parameter}" />
            <DataGridTextColumn Header="Send" Width="Auto" MinWidth="95"
                                Binding="{Binding Send, StringFormat='{}{0:dd.MM.yy HH:mm:ss}'}" />
            <DataGridTextColumn Header="Received" Width="Auto" MinWidth="110"
                                Binding="{Binding Received, StringFormat='{}{0:dd.MM.yy HH:mm:ss}'}" />
            <DataGridTextColumn Header="Count" Width="Auto" MinWidth="75" Binding="{Binding DataCount}" />
          </DataGrid.Columns>
        </DataGrid>

        <!-- Birko's ObjectTree walks the response graph itself (POCOs, dictionaries, collections,
             JsonNode) with type-colored monospaced values, and reports the selected node's value +
             path so the context menu can act on it. Null members are hidden: one client model serves
             several products (EliteCZ fills UltimateCZ's classes), so fields a product does not return
             are null and would read as if FinStat had sent them. -->
        <TabControl x:Name="tabControlResponse" Grid.Column="1">
          <TabItem Header="Data">
            <ScrollViewer>
              <c:ObjectTree x:Name="objectTreeData" HideNullMembers="True" Margin="{DynamicResource MarginSm}">
                <c:ObjectTree.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy Value To Clipboard" Click="treeCopyValueToClipboard_Click" />
                    <MenuItem Header="Copy JSON To Clipboard" Click="treeCopyToClipboard_Click" />
                    <Separator />
                    <MenuItem Header="Show JSON In Output Window" Click="treeShowJSONInOutputWindow_Click" />
                    <MenuItem Header="Show XML In Output Window" Click="treeShowXMLInOutputWindow_Click" />
                  </ContextMenu>
                </c:ObjectTree.ContextMenu>
              </c:ObjectTree>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Headers">
            <ScrollViewer>
              <c:ObjectTree x:Name="objectTreeHeaders" Margin="{DynamicResource MarginSm}" />
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Grid>
    </DockPanel>

    <!-- ── Settings (the Fluent Backstage's replacement): Birko Modal + schema-driven Form ── -->
    <c:Modal x:Name="settingsModal" Title="FinStat API Tester — Access">
      <StackPanel Spacing="16">
        <!-- The fields overflow a short window; the buttons stay pinned below the scroll area. -->
        <ScrollViewer MaxHeight="460" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8">
            <c:Form x:Name="settingsForm" />
            <!-- Environment: the profile picked here is the active one once the settings are used. -->
            <TextBlock Classes="aboutHeading" Text="Environment" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
              <ComboBox x:Name="comboBoxProfileEdit" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Profile"
                        ToolTip.Tip="Which FinStat servers the tester calls. Built-in profiles allow changing only the port, the keys and the colour; duplicate one to change its hosts."
                        SelectionChanged="comboBoxProfileEdit_SelectionChanged" />
              <Button Grid.Column="1" Content="Duplicate" Click="buttonProfileDuplicate_Click" />
              <Button Grid.Column="2" x:Name="buttonProfileDelete" Content="Delete" Click="buttonProfileDelete_Click" />
            </Grid>
            <c:Form x:Name="profileForm" />
          </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="textBlockSettingsErrors"
                   IsVisible="False" TextWrapping="Wrap"
                   Foreground="{DynamicResource BColorDangerTextBrush}" />
        <Grid ColumnDefinitions="*,*,*">
          <Button Grid.Column="0" Content="Use" HorizontalAlignment="Stretch"
                  Margin="0,0,4,0" Click="buttonSave_Click" />
          <Button Grid.Column="1" Content="Use and Save" HorizontalAlignment="Stretch"
                  Margin="4,0" Click="buttonSaveAndStore_Click" />
          <Button Grid.Column="2" Content="Cancel" HorizontalAlignment="Stretch"
                  Margin="4,0,0,0" Click="buttonCancel_Click" />
        </Grid>
      </StackPanel>
    </c:Modal>

    <!-- ── About: versions from the loaded assemblies (MainWindow_About.cs) + project links ── -->
    <c:Modal x:Name="aboutModal" Title="About">
      <!-- DockPanel, not StackPanel: a StackPanel hands its children unlimited height, so the scroll
           area never scrolled and a short window clipped the bottom links and Close. Docked, the
           ScrollViewer gets only what is left of the window and Close stays pinned below it. -->
      <DockPanel MinWidth="380">
        <Button DockPanel.Dock="Bottom" Content="Close" HorizontalAlignment="Right"
                Margin="0,16,0,0" Click="buttonAboutClose_Click" />
        <ScrollViewer MaxHeight="440" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14">
        <StackPanel Spacing="2">
          <TextBlock Text="FinStat API Tester" FontWeight="SemiBold"
                     FontSize="{DynamicResource BTextLg}" />
          <TextBlock Text="Desktop tester for the FinStat SK and CZ APIs."
                     Foreground="{DynamicResource BTextMutedBrush}" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="aboutHeading" Text="Versions" />
          <Grid x:Name="gridAboutVersions" ColumnDefinitions="Auto,*" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="aboutHeading" Text="Author" />
          <Button Classes="link" Content="birko · github.com/birko"
                  Tag="https://github.com/birko" Click="aboutLink_Click" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="aboutHeading" Text="Powered by" />
          <Button Classes="link" Content="Birko.Framework"
                  Tag="https://github.com/Birko-Framework/Birko.Framework" Click="aboutLink_Click" />
          <Button Classes="link" Content="Birko.Xaml.Core"
                  Tag="https://github.com/Birko-Framework/Birko.Framework/tree/main/Birko.Xaml.Core" Click="aboutLink_Click" />
          <Button Classes="link" Content="Birko.Xaml.Avalonia"
                  Tag="https://github.com/Birko-Framework/Birko.Framework/tree/main/Birko.Xaml.Avalonia" Click="aboutLink_Click" />
          <Button Classes="link" Content="Avalonia UI"
                  Tag="https://avaloniaui.net" Click="aboutLink_Click" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="aboutHeading" Text="FinStat API" />
          <Button Classes="link" Content="Documentation"
                  Tag="https://finstat.github.io/api-documentation/" Click="aboutLink_Click" />
          <Button Classes="link" Content="C# client library"
                  Tag="https://github.com/finstat/ClientApi.CSharp" Click="aboutLink_Click" />
        </StackPanel>
        </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </c:Modal>

    <!-- ── Ctrl+K palette over every ribbon command ─────────────────────────── -->
    <c:CommandPalette x:Name="commandPalette" />

  </Panel>
</Window>
